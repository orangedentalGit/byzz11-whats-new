{
  "name": "byzz-11-deck-build",
  "private": true,
  "version": "1.0.0",
  "description": "Einmalige Build-Werkzeuge fuer das byzz-11-Deck. Wird zur Laufzeit der Praesentation NICHT benoetigt.",
  "type": "module",
  "scripts": {
    "images": "node prepare-images.mjs",
    "video": "node prepare-video.mjs",
    "fonts": "node embed-fonts.mjs",
    "qr": "node make-qr.mjs",
    "assets": "npm run images && npm run video && npm run fonts && npm run qr",
    "assemble": "node assemble.mjs",
    "shots": "node shot.mjs --frag",
    "pdf": "node pdf.mjs",
    "verify": "node verify.mjs",
    "clean": "node -e \"['shots','frames','tmp-video'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "ffmpeg-static": "^5.2.0",
    "puppeteer-core": "^25.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2"
  }
}
